# =============================================================================
# ZKM Environment Variables
#
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
#
# Generation commands:
#   JWT_SECRET:     openssl rand -base64 64
#   TEMP_TOKEN_SECRET: openssl rand -base64 64
#   POSTGRES_PASSWORD: openssl rand -base64 32
# =============================================================================

# ── Node Environment ────────────────────────────────────────────────────────
# "production" enables TLS enforcement, HSTS, upgrade-insecure-requests CSP
NODE_ENV=production

# ── Server ──────────────────────────────────────────────────────────────────
# Port to listen on (default 3000 — reverse proxy should handle TLS)
PORT=3000

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://zkm:CHANGE_ME@db:5432/zkm?schema=public

# PostgreSQL password (used by docker-compose for the db service)
POSTGRES_PASSWORD=CHANGE_ME

# ── Authentication ──────────────────────────────────────────────────────────
# JWT signing key — used for session tokens (HS256)
# MUST be at least 64 bytes of random data
# Rotate by: 1) set JWT_SECRET_PREV to old value, 2) set JWT_SECRET to new value
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64

# Previous JWT signing key (optional) — used during key rotation
# When set, tokens signed with the OLD key remain valid until they expire.
# Set this to the current JWT_SECRET before rotating.
# Clear this after all old tokens have expired (max JWT_EXPIRES_IN duration).
JWT_SECRET_PREV=

# JWT token lifetime (default 15 minutes)
JWT_EXPIRES_IN=15m

# 2FA temporary token secret — separate from JWT secret for defense-in-depth
# Short-lived (5 min), scoped to 2FA step only
TEMP_TOKEN_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com
